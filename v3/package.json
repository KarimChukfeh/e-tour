{
  "name": "e-tour-v3",
  "version": "3.0.0",
  "description": "ETour V3 factory/instance architecture with instance-scoped session authorization",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "npm run sdk:build && hardhat test",
    "test:report": "node scripts/generate-test-report.js",
    "test:focused": "hardhat test",
    "test:aa": "hardhat test test/account-abstraction/*.test.js",
    "test:sdk": "npm run sdk:build && hardhat test test/sdk/*.test.js",
    "test:fuzz": "hardhat test test/session/SessionKeyRegistry.test.js test/session/SessionGameplay.test.js test/factory/PlayerProfile.test.js",
    "coverage": "hardhat coverage",
    "coverage:check": "node scripts/check-coverage-thresholds.js",
    "coverage:session": "hardhat coverage --testfiles 'test/session/*.test.js' && node scripts/check-coverage-thresholds.js",
    "sdk:build": "tsc --project sdk/tsconfig.json",
    "sdk:check": "tsc --project sdk/tsconfig.json --noEmit",
    "session:generate:dev": "npm run sdk:build && node scripts/generate-development-session.js",
    "session:compute": "hardhat run scripts/compute-session-executor.js --network localhost",
    "session:inspect": "hardhat run scripts/inspect-session.js --network localhost",
    "session:refresh": "hardhat run scripts/refresh-session.js --network localhost",
    "session:revoke": "hardhat run scripts/revoke-session.js --network localhost",
    "session:userop:local": "npm run sdk:build && hardhat run scripts/local-user-operation.js --network localhost",
    "entrypoint:check": "hardhat run scripts/check-entrypoint.js --network localhost",
    "secrets:check": "node scripts/check-secret-output.js",
    "deployment:smoke": "hardhat run scripts/smoke-deployment.js --network localhost",
    "deployment:manifest:check": "node scripts/check-deployment-manifest.js --network localhost",
    "deployment:verify:dry": "DRY_RUN=1 hardhat run scripts/verify-deployment.js --network arbitrum",
    "deployment:verify:arbitrum": "hardhat run scripts/verify-deployment.js --network arbitrum",
    "aa:gas:capture": "AA_GAS_FILE=baselines/account-abstraction-gas.json hardhat test test/account-abstraction/*.test.js",
    "aa:compile": "node scripts/check-account-abstraction-artifacts.js",
    "aa:deploy:localhost": "hardhat run scripts/deploy-local-account-abstraction.js --network localhost",
    "bundlers:check": "hardhat --config hardhat.arbitrum-local.config.js run scripts/check-local-bundlers.js --network arbitrumLocal",
    "bundlers:check:production": "AA_NETWORK=arbitrumOne node scripts/check-bundlers.js",
    "paymaster:inspect": "hardhat run scripts/inspect-paymaster.js --network localhost",
    "warnings:check": "node scripts/check-compiler-warnings.js",
    "warnings:capture": "node scripts/check-compiler-warnings.js --write",
    "natspec:check": "node scripts/check-natspec.js",
    "abi:generate": "node scripts/regenerate-abis.js",
    "abi:check": "node scripts/check-abi-surface.js",
    "abi:capture": "node scripts/check-abi-surface.js --write",
    "abi:v2-compare": "node scripts/compare-v2-v3-abi.js",
    "abi:v2-capture": "node scripts/compare-v2-v3-abi.js --write",
    "selectors:check": "node scripts/check-instance-selectors.js",
    "abi:sync": "node scripts/generate-and-sync-frontend-v2-abis.js --network localhost",
    "frontend:abis": "node scripts/generate-and-sync-frontend-v2-abis.js --network localhost",
    "size": "node scripts/check-contract-sizes.js",
    "size:capture": "node scripts/check-contract-sizes.js --write",
    "contracts:check": "npm run aa:compile && npm run compile && npm run size",
    "storage:check": "node scripts/check-storage-layout.js",
    "storage:capture": "node scripts/check-storage-layout.js --write",
    "static:check": "node scripts/check-static-analysis.js",
    "static:capture": "node scripts/check-static-analysis.js --write",
    "security:check": "node scripts/check-security-review.js",
    "audit:check": "node scripts/check-dependency-audit.js",
    "audit:capture": "node scripts/check-dependency-audit.js --write",
    "release:prepare": "node scripts/prepare-production-release.js",
    "release:template:check": "node scripts/check-production-release-template.js",
    "release:freeze:capture": "node scripts/check-release-freeze.js --write",
    "release:freeze:check": "node scripts/check-release-freeze.js",
    "release:ready": "node scripts/check-release-readiness.js",
    "release:address-book": "node scripts/build-release-address-book.js",
    "routing:check": "node scripts/check-generation-routing.js",
    "monitoring:check": "node scripts/check-monitoring-config.js",
    "ci:checks": "npm run sdk:check && npm run secrets:check && npm run aa:compile && npm run warnings:check && npm run natspec:check && npm run size && npm run storage:check && npm run abi:check && npm run abi:v2-compare && npm run selectors:check && npm run static:check && npm run security:check && npm run audit:check && npm run release:template:check && npm run release:freeze:check && npm run routing:check && npm run monitoring:check",
    "gas": "REPORT_GAS=1 hardhat test",
    "gas:capture": "REPORT_GAS=1 REPORT_GAS_FILE=baselines/gas-report.txt hardhat test",
    "gas:baseline": "hardhat run scripts/capture-gas-baseline.js",
    "deploy:modules": "hardhat run scripts/deploy-instance-modules.js --network localhost",
    "deploy:tictac": "hardhat run scripts/deploy-tictacchain-factory.js --network localhost",
    "deploy:connectfour": "hardhat run scripts/deploy-connectfour-factory.js --network localhost",
    "deploy:chess": "hardhat run scripts/deploy-chessonchain-factory.js --network localhost",
    "deploy:factories": "hardhat run scripts/deploy-factories.js --network localhost",
    "deploy:all": "hardhat run scripts/deploy-all-factory.js --network localhost",
    "deploy:all:force": "FORCE=1 hardhat run scripts/deploy-all-factory.js --network localhost",
    "local:arbitrum:node": "hardhat --config hardhat.arbitrum-local.config.js node --hostname 127.0.0.1 --port 8546",
    "local:arbitrum:deploy": "FORCE=1 hardhat --config hardhat.arbitrum-local.config.js run scripts/deploy-all-factory.js --network arbitrumLocal",
    "local:arbitrum:accept": "npm run sdk:build && hardhat --config hardhat.arbitrum-local.config.js run scripts/local-arbitrum-acceptance.js --network arbitrumLocal",
    "local:arbitrum:cycle": "node scripts/run-local-arbitrum-cycle.js",
    "local:arbitrum:cycle:full": "node scripts/run-local-arbitrum-cycle.js --full"
  },
  "devDependencies": {
    "@nomicfoundation/edr": "0.12.0-next.16",
    "@nomicfoundation/hardhat-ethers": "3.1.2",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "hardhat": "2.27.0",
    "solc": "0.8.28",
    "solhint": "6.2.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.8.0",
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "17.2.3"
  }
}
