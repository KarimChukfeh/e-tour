{
  "schemaVersion": 1,
  "contracts": [
    "TicTacInstance",
    "ConnectFourInstance",
    "ChessInstance"
  ],
  "selectors": [
    {
      "signature": "claimTimeoutWin(uint8,uint8)",
      "selector": "0x01864d14",
      "stateMutability": "nonpayable",
      "access": "match-participant",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "The non-current match participant may claim after the current player's clock expires."
    },
    {
      "signature": "enrollOnBehalf(address)",
      "selector": "0x206e5718",
      "stateMutability": "payable",
      "access": "factory-only",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "The creating factory atomically auto-enrolls the creator."
    },
    {
      "signature": "makeMove(uint8,uint8,uint8,uint8,uint8)",
      "selector": "0x23e737aa",
      "stateMutability": "nonpayable",
      "access": "current-gameplay-actor",
      "contracts": ["ChessInstance"],
      "rationale": "Chess gameplay entry point; V3 session resolution will be limited to this selector."
    },
    {
      "signature": "initializeChess((uint8,uint256,(uint256,uint256,uint256,uint256,uint256,uint256),uint8,bytes32),address,address,address,address,address,address,address)",
      "selector": "0x2d019c39",
      "stateMutability": "nonpayable",
      "access": "atomic-clone-initializer",
