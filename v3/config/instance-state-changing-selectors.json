      "stateMutability": "nonpayable",
      "access": "instance-self-only",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Protected module-to-instance match creation bridge."
    },
    {
      "signature": "forceEliminateStalledMatch(uint8,uint8)",
      "selector": "0x93998a73",
      "stateMutability": "nonpayable",
      "access": "advanced-player-after-escalation",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
