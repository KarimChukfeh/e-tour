    },
    {
      "signature": "claimMatchSlotByReplacement(uint8,uint8)",
      "selector": "0x7244639f",
      "stateMutability": "nonpayable",
      "access": "eligible-external-player-after-escalation",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Intentionally permissionless to an eligible non-advanced player after level-three escalation."
    },
