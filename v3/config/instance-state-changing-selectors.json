      "selector": "0x6a9d6eda",
      "stateMutability": "nonpayable",
      "access": "atomic-clone-initializer",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "A factory initializes a fresh clone in the same transaction that creates it; the one-time guard prevents reuse."
    },
