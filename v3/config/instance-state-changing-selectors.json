    },
    {
      "signature": "_setMatchPlayer(bytes32,uint8,address)",
      "selector": "0x95dd9176",
      "stateMutability": "nonpayable",
      "access": "instance-self-only",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Protected module-to-instance bracket assignment bridge."
    },
    {
      "signature": "makeMove(uint8,uint8,uint8)",
      "selector": "0x960edffb",
      "stateMutability": "nonpayable",
      "access": "current-gameplay-actor",
      "contracts": ["TicTacInstance", "ConnectFourInstance"],
      "rationale": "Tic-Tac-Toe and Connect Four gameplay entry point; V3 session resolution will be limited to this selector."
    },
    {
      "signature": "_initializeMatchForPlay(bytes32)",
      "selector": "0xd7f8f16a",
      "stateMutability": "nonpayable",
      "access": "instance-self-only",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Protected module-to-instance match activation bridge."
    },
    {
      "signature": "_resetMatchGame(bytes32)",
      "selector": "0xd893088d",
      "stateMutability": "nonpayable",
      "access": "instance-self-only",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Protected module-to-instance match reset bridge."
    },
    {
      "signature": "claimAbandonedPool()",
      "selector": "0xe1d39ee8",
      "stateMutability": "nonpayable",
      "access": "permissionless-after-enrollment-escalation",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Intentionally permissionless after the abandoned-enrollment deadline and subject to pool-state checks."
    },
    {
      "signature": "enrollInTournament()",
      "selector": "0xef55ac9f",
      "stateMutability": "payable",
      "access": "public-exact-stake",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Primary-wallet enrollment with the exact configured entry fee."
    },
    {
      "signature": "_completeMatchWithResult(bytes32,address,bool)",
      "selector": "0xf4df7cf0",
      "stateMutability": "nonpayable",
      "access": "instance-self-only",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "Protected module-to-instance escalation completion bridge."
    }
