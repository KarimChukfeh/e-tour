      "stateMutability": "nonpayable",
      "access": "enrolled-player-after-deadline",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "An enrolled player may force-start a sufficiently populated tournament after enrollment expiry."
    },
    {
      "signature": "cancelTournament()",
      "selector": "0x646156aa",
      "stateMutability": "nonpayable",
      "access": "solo-enrolled-player",
      "contracts": ["TicTacInstance", "ConnectFourInstance", "ChessInstance"],
      "rationale": "The sole enrolled player may cancel and receive the defined refund."
    },
    {
